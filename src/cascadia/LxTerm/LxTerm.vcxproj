<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <ProjectGuid>{7A11C0DE-1EA1-4E9C-9B01-000000000001}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <ProjectName>LxTerm</ProjectName>
    <TargetName>laymux_wt</TargetName>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <RootNamespace>LxTerm</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="NuGet Dependencies">
    <TerminalCppWinrt>true</TerminalCppWinrt>
  </PropertyGroup>

  <Import Project="..\..\..\common.openconsole.props" Condition="'$(OpenConsoleDir)'==''" />
  <Import Project="$(OpenConsoleDir)src\common.nugetversions.props" />
  <Import Project="$(OpenConsoleDir)src\cppwinrt.build.pre.props" />

  <ItemGroup>
    <ClCompile Include="lxterm.cpp" />
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="lxterm.h" />
    <ClInclude Include="pch.h" />
  </ItemGroup>

  <!-- ============================ References ============================  -->
  <ItemGroup>
    <ProjectReference Include="$(OpenConsoleDir)src\cascadia\TerminalCore\lib\terminalcore-lib.vcxproj">
      <Project>{CA5CAD1A-ABCD-429C-B551-8562EC954746}</Project>
    </ProjectReference>
  </ItemGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PreprocessorDefinitions>LXTERM_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Same trick TerminalCore uses: reach the SDK's cppwinrt headers plus
           TerminalCore's generated projection headers without a project reference
           that msbuild would misinterpret. -->
      <AdditionalIncludeDirectories>$(WinRT_IncludePath)\..\cppwinrt\winrt;"$(OpenConsoleDir)src\cascadia\TerminalCore\Generated Files";%(AdditionalIncludeDirectories);</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>onecore.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- Careful reordering these. Some default props (contained in these files) are order sensitive. -->
  <Import Project="$(OpenConsoleDir)src\cppwinrt.build.post.props" />
  <Import Project="$(OpenConsoleDir)src\common.nugetversions.targets" />
</Project>
